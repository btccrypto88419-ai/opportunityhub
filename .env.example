# =============================================================================
# OpportunityHub — Environment Variables
# =============================================================================
# Copy this file to `.env` (which is git-ignored) and fill in your own values.
# NEVER commit a real .env file or paste secret/service-role keys into code,
# commits, or chat. Only the PUBLIC "anon" key belongs in the frontend.
# =============================================================================

# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Supabase "anon" / public API key (safe for the browser — protected by RLS).
# Do NOT use the service_role key here, ever.
VITE_SUPABASE_ANON_KEY=

# Optional: public site URL, used for building absolute links (referral links,
# password-reset redirect target, social sharing, etc).
VITE_SITE_URL=http://localhost:5173
